# URL publicznej strony / profilu do monitorowania
TARGET_URL=https://www.facebook.com/NazwaStrony

# Co ile sekund sprawdzać (domyślnie 300 = 5 min)
CHECK_EVERY_SEC=300

# Ile razy przewinąć wall przy każdym checku
SCROLL_TIMES=4

# Opcjonalnie: powiadomienia Telegram
# 1) napisz do @BotFather -> /newbot -> skopiuj token
# 2) napisz coś do swojego bota, potem weź chat_id np. przez @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
